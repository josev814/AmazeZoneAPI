# RUBY ENV SETTINGS
COVERAGE=true
RUBY_COVERAGE=true
RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
BUNDLE_PATH='/usr/local/bundle'
# Host port the API is published on (compose maps API_PORT:3005; the container always listens on 3005). Default: 3005
API_PORT=3005

# NODE ENV SETTINGS
NODE_ENV=development
